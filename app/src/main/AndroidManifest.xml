<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        ConnectionService keeps SSH transport open for the user's interactive
        terminal sessions (potentially many hours). The dataSync FGS type
        carries a hard 6 h / 24 h limit on Android 14+ and crashes the next
        startForeground() once the budget is exhausted (see
        oridev-error-terminal-open-shell-2026-04-25-* and the embedded
        04-23 / 04-24 ForegroundServiceStartNotAllowedException stacks).
        specialUse is the documented escape hatch for use cases not covered
        by the typed FGS list. TransferEngineService keeps dataSync —
        transfers are bounded and dataSync is semantically correct there.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Phase 15 Task 15.6 — local file access uses the Storage Access
        Framework (`DocumentFile.fromTreeUri`) only. No
        READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE
        declarations; SAF requests are scoped per user-picked tree via an
        Intent contract and need no manifest permission. The persisted
        grants survive reboot via ContentResolver.takePersistableUriPermission.
        Adding the broad storage permissions back would force a Play Store
        "Permissions Declaration Form" review for general-purpose apps.
    -->

    <application
        android:name=".OriDevApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OriDev">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"
            tools:replace="android:value" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ConnectionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!--
                Required by Android 14+ for FGS_TYPE_SPECIAL_USE: a free-form
                rationale Google reviewers see in the Play Console and the
                user surfaces in App Info. Wording stays factual ("interactive
                shell sessions") so it survives a future review without
                needing to be re-justified.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent SSH transport for interactive shell sessions" />
        </service>

        <service
            android:name=".service.TransferEngineService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".wear.WearMessageListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/oridev/" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
